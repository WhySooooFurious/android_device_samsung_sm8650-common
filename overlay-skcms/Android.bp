// A16 base libskia_skcms (external/skia) is not vendor_available, but
// libjxl (vendor_available) depends on it. Full copy that is vendor_available;
// the product builds it and `overrides` excludes the base module.
cc_library_static {
    name: "libskia_skcms_vendor_override",
    overrides: ["libskia_skcms"],
    vendor_available: true,
    host_supported: true,
    sdk_version: "current",
    srcs: [
        "../../../../external/skia/modules/skcms/skcms.cc",
        "../../../../external/skia/modules/skcms/src/skcms_TransformBaseline.cc",
    ],
    export_include_dirs: [
        "../../../../external/skia/modules/skcms",
    ],
}
