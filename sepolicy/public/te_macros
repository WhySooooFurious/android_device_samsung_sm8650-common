# LineageOS te_macros. The vendor sepolicy build on A17 does not include
# device/lineage/sepolicy/common/public/te_macros, so provide the macros
# here (this public dir is merged into the vendor conf before first use).

# rw_dir_file(domain, type)
define(`rw_dir_file', `
allow $1 $2:dir r_dir_perms;
allow $1 $2:{ file lnk_file } rw_file_perms;
')

# create_dir_file(domain, type)
define(`create_dir_file', `
allow $1 $2:dir r_dir_perms;
allow $1 $2:{ file lnk_file } create_file_perms;
')

# hal_attribute_lineage(hal_name)
define(`hal_attribute_lineage', `
attribute hal_$1;
expandattribute hal_$1 true;
attribute hal_$1_client;
expandattribute hal_$1_client true;
attribute hal_$1_server;
expandattribute hal_$1_server false;
')

# Declare the LineageOS HAL interface attributes here, before first use
# in the vendor conf. checkpolicy allows forward type references but not
# forward attribute references.
hal_attribute_lineage(lineage_health)
hal_attribute_lineage(lineage_livedisplay)
hal_attribute_lineage(lineage_powershare)
hal_attribute_lineage(lineage_touch)
hal_attribute_lineage(samsung_spen)
