# The QSPM HAL daemon is not packaged (stock blobs ship only the
# client lib), so apps probing the service get find denials.
# The hal_attribute_service() neverallow only permits find by a
# fixed set of app types; platform-private types (e.g.
# permissioncontroller_app) are not vendor-visible, so allow the
# vendor-visible system_app type only.
allow system_app vendor_hal_qspmhal_service:service_manager { find };
