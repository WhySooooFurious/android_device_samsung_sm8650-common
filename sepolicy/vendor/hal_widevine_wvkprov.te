# Samsung Widevine keyprov HAL (ISehWidevineKeyProv)
# Ported from the reference ROM device stack (hal_widevine_wvkprov.te).

type hal_wvkprov_default, domain;
typeattribute hal_wvkprov_default halserverdomain;

type hal_wvkprov_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_wvkprov_default);

type wvkprov, domain;
type wvkprov_exec, exec_type, vendor_file_type, file_type;

type hal_wvkprov_service, service_manager_type;

# clients: mediadrmserver + hal_drm_widevine (per reference policy)
allow mediadrmserver hal_wvkprov_default binder call transfer;
allow hal_drm_widevine hal_wvkprov_default binder call transfer;
allow hal_wvkprov_default mediadrmserver binder call transfer;
allow hal_wvkprov_default hal_drm_widevine binder call transfer;
allow mediadrmserver hal_wvkprov_default fd use;
allow hal_drm_widevine hal_wvkprov_default fd use;
allow hal_wvkprov_default mediadrmserver fd use;
allow hal_wvkprov_default hal_drm_widevine fd use;
allow hal_wvkprov_default hal_wvkprov_service service_manager add find;
allow mediadrmserver hal_wvkprov_service service_manager find;
allow hal_drm_widevine hal_wvkprov_service service_manager find;
allow hal_wvkprov_default vndservicemanager binder call transfer;
allow vndservicemanager hal_wvkprov_default binder transfer;
allow vndservicemanager hal_wvkprov_default dir search;
allow vndservicemanager hal_wvkprov_default file read map open;
allow vndservicemanager hal_wvkprov_default process getattr;
allow hal_wvkprov_default vndbinder_device chr_file ioctl read write getattr lock append map open watch watch_reads;
allow hal_wvkprov_default tee_device chr_file ioctl read write getattr lock append map open watch watch_reads;
allow hal_wvkprov_default ion_device chr_file ioctl read write getattr lock append map open watch watch_reads;
allow hal_wvkprov_default vendor_qce_device chr_file ioctl read write getattr lock append map open watch watch_reads;
allow hal_wvkprov_default dmabuf_heap_device chr_file ioctl read write getattr lock append map open watch watch_reads;
allow hal_wvkprov_default dmabuf_system_heap_device chr_file ioctl read write getattr lock append map open watch watch_reads;
allow hal_wvkprov_default vendor_dmabuf_qseecom_heap_device chr_file ioctl read write getattr lock append map open watch watch_reads;
allow hal_wvkprov_default efs_file dir ioctl read getattr lock open watch watch_reads search;
allow hal_wvkprov_default efs_file file ioctl read getattr lock map open watch watch_reads;
allow hal_wvkprov_default sec_efs_file dir ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir;
allow hal_wvkprov_default sec_efs_file file ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads;
allow hal_wvkprov_default wvkprov_exec file read getattr map execute open;
allow hal_wvkprov_default wvkprov process transition;
allow wvkprov wvkprov_exec file read getattr map execute open entrypoint;
typetransition hal_wvkprov_default wvkprov_exec process wvkprov;
allow wvkprov tee_device chr_file ioctl read write getattr lock append map open watch watch_reads;
allow wvkprov ion_device chr_file ioctl read write getattr lock append map open watch watch_reads;
allow wvkprov vendor_qce_device chr_file ioctl read write getattr lock append map open watch watch_reads;
allow wvkprov efs_file dir ioctl read getattr lock open watch watch_reads search;
allow wvkprov efs_file file ioctl read getattr lock map open watch watch_reads;
allow wvkprov sec_efs_file dir ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir;
allow wvkprov sec_efs_file file ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads;
allow wvkprov system_file dir search;
allow wvkprov vendor_dmabuf_qseecom_heap_device chr_file ioctl read getattr lock map open watch watch_reads;
allow wvkprov dmabuf_heap_device chr_file ioctl read getattr lock map open watch watch_reads;
allow wvkprov dmabuf_system_heap_device chr_file ioctl read getattr lock map open watch watch_reads;
