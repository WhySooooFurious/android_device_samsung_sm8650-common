// A16 base libhwy (external/google-highway) is not vendor_available, but
// libjxl (vendor_available) depends on it. Full copy that is vendor_available;
// the product builds it and `overrides` excludes the base module.
cc_library {
    name: "libhwy_vendor_override",
    overrides: ["libhwy"],
    vendor_available: true,
    host_supported: true,
    sdk_version: "current",
    stl: "c++_shared",
    export_include_dirs: [
        "../../../../google-highway",
    ],
    srcs: [
        "../../../../google-highway/hwy/contrib/sort/qgsort_*.cc",
        "../../../../google-highway/hwy/contrib/image/image.cc",
        "../../../../google-highway/hwy/contrib/thread_pool/topology.cc",
        "../../../../google-highway/hwy/abort.cc",
        "../../../../google-highway/hwy/aligned_allocator.cc",
        "../../../../google-highway/hwy/nanobenchmark.cc",
        "../../../../google-highway/hwy/per_target.cc",
        "../../../../google-highway/hwy/print.cc",
        "../../../../google-highway/hwy/targets.cc",
        "../../../../google-highway/hwy/timer.cc",
    ],
    visibility: [
        "//external/libjxl:__subpackages__",
        "//external/dng_sdk/fuzzer:__subpackages__",
    ],
}
